{
  "name": "pr-conventions-reviewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GitHub Action that reviews pull requests against the repository's own written rules.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "ncc build src/main.ts -o dist --license licenses.txt"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vercel/ncc": "0.45.0",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@actions/core": "3.0.1"
  }
}
